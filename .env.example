# Copy to .env at the repository root. Never put real credentials in this file.
APP_ENV=development
LOG_LEVEL=INFO
DATA_VERSION=unloaded

# Local development only. Compose uses these credentials and loopback host ports.
# Use URL-safe password characters here, since Compose builds the API database URL.
POSTGRES_PASSWORD=local-admin-password
APP_DB_PASSWORD=local-app-password
AGENT_DB_PASSWORD=local-agent-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# For running the API directly on the host. Compose sets its own internal URLs.
# DATABASE_URL_READONLY must use agent_ro; never reuse the write-role connection.
DATABASE_URL=postgresql+psycopg://app_rw:local-app-password@localhost:5432/nfl_universe
DATABASE_URL_READONLY=postgresql+psycopg://agent_ro:local-agent-password@localhost:5432/nfl_universe
REDIS_URL=redis://localhost:6379/0

# Configure future integrations when implemented. Blank values are unset.
S3_BUCKET=
AWS_REGION=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
RERANKER_MODEL=
JWT_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
