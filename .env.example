# Copy to .env at the repository root. Never put real credentials in this file.
APP_ENV=development
LOG_LEVEL=INFO
DATA_VERSION=unloaded

# Configure when the corresponding service is implemented. Blank values are unset.
# DATABASE_URL_READONLY must use agent_ro; never reuse the write-role connection.
DATABASE_URL=
DATABASE_URL_READONLY=
REDIS_URL=
S3_BUCKET=
AWS_REGION=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
RERANKER_MODEL=
JWT_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
